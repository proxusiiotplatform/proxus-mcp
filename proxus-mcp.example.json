{
  // OPC UA certificates: own/, trusted/, rejected/. Relative to this file.
  "pki_dir": "pki",
  // Optional folder of extra register maps (JSON). Relative to this file.
  // "maps_dir": "maps",
  // Every device the server may reach. Nothing outside this file is reachable.
  "devices": {
    "meter-1": {
      "protocol": "modbus-tcp",
      "host": "192.168.10.40",
      "port": 502,
      "unit_id": 1,
      "path": "Acme/Gebze/Energy/Meter1",
      "timeout_ms": 3000
      // Optional register map for read_named: a map id (find_device_map) or the path of a map's JSON file.
      // "map": "eastron/sdm630-modbus"
    },
    "press-3": {
      "protocol": "opc-ua",
      "endpoint": "opc.tcp://192.168.10.21:4840",
      "path": "Acme/Gebze/Press/Line3",
      "security_mode": "sign_and_encrypt",
      "security_policy": "Basic256Sha256",
      // Omit username for an anonymous login. The password is read from this environment variable.
      "username": "mcp-reader",
      "password_env": "PRESS3_OPCUA_PASSWORD"
    }
  }
}
